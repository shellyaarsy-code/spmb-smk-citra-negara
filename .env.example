# Local development only. Use a dedicated disposable local database; never paste production URLs here.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/spmb_dev?schema=public"

# Optional: direct Neon connection for Prisma CLI commands (for example, migrations).
# For Vercel, use a pooled Neon URL in DATABASE_URL and the direct URL in DIRECT_URL.
# In local development, omit DIRECT_URL to use DATABASE_URL for Prisma CLI commands.
# DIRECT_URL="postgresql://postgres:CHANGE_ME@HOST:5432/spmb_dev?schema=public"

# Optional, separately provisioned disposable database for integration checks.
# SPMB_TEST_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/spmb_test?schema=public"
# Explicit opt-in required before the database integration test performs its rollback-only fixture transaction.
# SPMB_TEST_DATABASE_WRITES="ALLOW_DISPOSABLE_DATABASE"

# Vercel Blob: connected Vercel deployments use BLOB_STORE_ID and short-lived OIDC automatically.
# For local development, use a dedicated non-production Blob read-write token from a demo/test store.
# BLOB_STORE_ID=""
# BLOB_READ_WRITE_TOKEN=""
# Explicit opt-in and a token restricted to a disposable demo/test store are required before the integration test writes.
# SPMB_TEST_BLOB_STORE_NAME="spmb-test-store"
# SPMB_TEST_BLOB_READ_WRITE_TOKEN=""
# SPMB_TEST_STORAGE_WRITES="ALLOW_TEST_BUCKET_WRITES"
# The defaults allow PDF, JPEG, and PNG up to 4 MiB; override only for the demo environment if needed.
SPMB_DOCUMENT_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"
SPMB_DOCUMENT_MAX_FILE_SIZE_BYTES="4194304"

# Use only for a disposable demo database when running `npm run prisma:seed:demo`.
# Keep the value private and do not use a real school or production password.
SPMB_DEMO_PASSWORD=""
SPMB_DEMO_SEED_CONFIRM=""
# Exact non-secret allowlist in hostname/database-name format; copy only from the isolated demo connection details.
SPMB_DEMO_SEED_TARGET=""
SPMB_DEMO_MODE="false"

# Keep false until official selection rules have written school approval.
SPMB_OFFICIAL_RULES_APPROVED="false"
